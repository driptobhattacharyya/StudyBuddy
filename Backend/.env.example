# Copy to .env and adjust. Every variable is optional unless noted.

# --- general -------------------------------------------------------------
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
# Comma separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# --- database ------------------------------------------------------------
# MongoDB Atlas / local URI. Use mongomock:// for a throw-away in-memory DB (needs requirements-dev.txt).
MONGODB_URI=mongodb://localhost:27017
DB_NAME=study_buddy

# --- auth ----------------------------------------------------------------
# REQUIRED in production: long random string (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback
# Comma separated e-mails that get the instructor / admin role on login
INSTRUCTOR_EMAILS=
ADMIN_EMAILS=
# Enables POST /auth/demo (one-click student / instructor / admin logins). Great for portfolio deployments.
DEMO_MODE=false
# Seed (idempotently) the demo dataset every time the API starts
SEED_DEMO_ON_STARTUP=false

# --- AI ------------------------------------------------------------------
# gemini | openai | openrouter | mock   (mock = deterministic offline responses, no key needed;
# it is also the automatic fallback when DEMO_MODE=true and the selected provider has no API key)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Also used for RAG embeddings; without a key retrieval falls back to BM25 keyword search
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# OpenAI (also used for RAG embeddings when AI_PROVIDER=openai). Keep the key in the backend environment only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_SECONDS=60
AI_MAX_INPUT_CHARS=8000
RAG_TOP_K=4
# Global cap on AI requests per UTC day (all users)
AI_DAILY_REQUEST_CAP=500
# Rough pricing for the admin cost estimate, USD per 1M tokens (free ":free" models cost 0)
AI_COST_IN_PER_MTOK=0.30
AI_COST_OUT_PER_MTOK=2.50

# --- code runner ---------------------------------------------------------
# local (hardened subprocess) | judge0
CODE_RUNNER=local
CODE_TIMEOUT_SECONDS=5
CODE_MAX_OUTPUT_BYTES=65536
CODE_MEMORY_MB=512
CODE_MAX_PROCS=256
CODE_MAX_CONCURRENCY=4
CODE_MAX_SOURCE_BYTES=65536
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token

# --- rate limits (per user / IP, per minute) ------------------------------
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_RUN_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=30
